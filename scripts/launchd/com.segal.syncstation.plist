<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.segal.syncstation</string>

  <!-- Sync worker via run-worker-foreground.sh, which EXECs the worker so this
       job process IS the worker. Foreground + KeepAlive → launchd keeps it alive
       and restarts it on crash or reboot (fixes the old reaping problem, where a
       nohup child died when the launcher script exited). The Cloud SQL proxy has
       its own agent (com.segal.sqlproxy); the wrapper waits for it. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/marcelo/Projects/segal-case-tracker/scripts/run-worker-foreground.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/marcelo</string>
    <!-- Daily-sweep mode. The goal is to answer "which causas moved today",
         which needs the WHOLE portfolio visited often, not a drained PDF queue.

         DETAIL_PENDING_DOCS_FIRST is deliberately NOT set here. It ordered the
         rotation by "most pending PDFs first", i.e. it picked the most
         EXPENSIVE causas on every cycle: measured on this station, a causa with
         no new movements costs 1.1s while its PDFs cost 3.5s each. That
         ordering is a direct cause of the ~80-day full lap. Without it the
         rotation falls back to "least recently detailed first", which is what a
         sweep wants. Turn it back on only to drain a PDF backlog, and expect
         freshness to collapse while it is on.

         The larger batch and shorter cycle below are KEPT on purpose: the old
         defaults (30 / 4h) are slower, and a daily sweep needs more throughput,
         not less. Do not "restore the defaults" without re-reading this. -->
    <key>DETAIL_BATCH</key>
    <string>80</string>
    <key>SYNC_INTERVAL</key>
    <string>2</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/tmp/segal-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/segal-worker.log</string>
</dict>
</plist>
