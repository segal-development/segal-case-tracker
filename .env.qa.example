# =============================================================================
# .env.qa.example — QA environment template
#
# Copy this file to .env.qa and fill in every variable before running:
#   docker compose -f docker-compose.yml -f docker-compose.qa.yml up -d
#
# NEVER commit .env.qa to version control.
# This file (*.example) is safe to commit — it contains no real secrets.
# =============================================================================


# =============================================================================
# DATABASE (Cloud SQL — values used to build DATABASE_URL in docker-compose.qa.yml)
# =============================================================================

# PostgreSQL user for the Cloud SQL instance
DB_USER=segal_qa

# PostgreSQL password (store in Secret Manager; paste here for local override)
DB_PASSWORD=

# PostgreSQL database name
DB_NAME=segal_case_tracker_qa


# =============================================================================
# GCP INFRASTRUCTURE
# =============================================================================

# Cloud SQL instance connection name: <project>:<region>:<instance>
# Example: my-project:us-central1:segal-qa-pg16
CLOUD_SQL_INSTANCE_CONNECTION_NAME=

# Absolute path on the HOST machine to the service account JSON key.
# This file is bind-mounted read-only into the cloud-sql-proxy container.
# Example: /home/deploy/secrets/sa-key.json
GOOGLE_APPLICATION_CREDENTIALS_PATH=/home/deploy/secrets/sa-key.json

# GCS bucket name for document storage (DOC_STORAGE_BACKEND=gcs)
# Example: segal-case-tracker-qa-docs
GCS_BUCKET=


# =============================================================================
# REDIS
# =============================================================================

# Overridden to point at the redis service inside Docker.
# Only change if you use an external Redis (e.g., Memorystore).
REDIS_URL=redis://redis:6379/0


# =============================================================================
# AUTH / SECURITY
# =============================================================================

# JWT signing secret — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet symmetric key for reversible PJUD credential encryption.
# MUST be a valid URL-safe base64-encoded 32-byte key.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this key invalidates all stored encrypted_pjud_password values.
#          Re-encrypt all rows before rotating the key.
ENCRYPTION_KEY=


# =============================================================================
# CAPTCHA (2Captcha — required for autonomous PJUD password re-auth)
# =============================================================================

# 2Captcha API key (https://2captcha.com).
# When set, the worker scheduler can autonomously solve reCAPTCHA v3 during
# PJUD session re-auth for lawyers using the captcha auth method.
# Leave empty to disable captcha re-auth (lawyers will be skipped on expiry).
CAPTCHA_API_KEY=


# =============================================================================
# EMAIL (SendGrid)
# =============================================================================

# SendGrid API key for movement alert emails
SENDGRID_API_KEY=

# Sender email address shown to recipients.
# Maps to FROM_EMAIL in app/config.py Settings.
SENDGRID_FROM_EMAIL=notificaciones@segal.cl


# =============================================================================
# APP
# =============================================================================

# Public-facing base URL (no trailing slash).
# Maps to APP_URL in app/config.py Settings.
# Used in email links and PJUD redirect URLs.
BASE_URL=https://qa.yourdomain.com

# Allowed CORS origins (comma-separated, no trailing slash, no wildcards).
# Must include the frontend origin.
CORS_ORIGINS=https://qa.yourdomain.com


# =============================================================================
# WORKER / SYNC TUNING
# =============================================================================

# How often (hours) the scheduler triggers a sync for all active lawyers.
# Default: 4
SYNC_INTERVAL_HOURS=4

# Maximum data age (hours) before a lawyer sync is considered stale.
# Default: 4
MAX_DATA_AGE_HOURS=4

# Detail batch size — number of cases checked per rotation cycle.
# Default: 30 (from Settings). Only override if needed.
# DETAIL_BATCH_SIZE=30

# Delay (seconds) between consecutive PJUD detail fetches.
# Default: 2.0 (from Settings). Increase if PJUD rate-limits the worker.
# DETAIL_FETCH_DELAY=2.0


# =============================================================================
# PJUD RESILIENCE (optional overrides — defaults are usually fine)
# =============================================================================

# PJUD_CB_FAILURE_THRESHOLD=5
# PJUD_CB_RECOVERY_TIMEOUT=60
# PJUD_RETRY_MAX_ATTEMPTS=3
# PJUD_RETRY_BASE_DELAY=1.0
# PJUD_RETRY_MAX_DELAY=30.0
# PJUD_RATE_LIMIT=10.0
# PJUD_RATE_BURST=20
